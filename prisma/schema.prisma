// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  description String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id    String @id @default(uuid())
  email String @unique
  password String?
  name String?

  userRoles   UserRole[]
  tenantUsers TenantUser[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRole {
  id String @id @default(uuid())

  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model RolePermission {
  id String @id @default(uuid())

  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
}

model Tenant {
  id     String @id @default(uuid())
  name   String
  slug   String @unique
  status String @default("active")

  users    TenantUser[]
  settings TenantSetting[]
  customers Customer[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model TenantUser {
  id String @id @default(uuid())

  tenantId String
  userId   String
  status   String @default("active")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId])
}

model TenantSetting {
  id String @id @default(uuid())

  tenantId String
  key      String
  value    Json?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
}

model Customer {
  id       String @id @default(uuid())
  tenantId String

  firstName String
  lastName  String

  insuranceNumber String?
  birthDate       DateTime?

  status String?
  source String?

  tags String[]

  phone String?
  email String?

  // Adresse
  street            String?
  houseNumber       String?
  houseNumberSuffix String?
  zip               String?
  city              String?
  country           String? @default("DE")

  // Pflege / Versicherung
  careLevel     Int?
  insuranceType String?
  insuranceName String?
  insuranceIk   String?

  // Vermittler
  brokerName   String?
  brokerNumber String?
  brokerShop   String?

  // PG/KV Status
  pg51Status String?
  pg54Status String?

  notes String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@index([lastName])
  @@index([insuranceNumber])
  @@index([status])
  @@index([insuranceName])
  @@index([brokerName])
}
